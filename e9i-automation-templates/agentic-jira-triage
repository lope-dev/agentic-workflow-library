      "parameters": {
        "jsCode": "// This node receives items routed from the If-loop's TRUE branch (status = \"success\")\n// Match service name already validated serviceName and JiraAccountId \u2014 we trust that here.\n// We do a final safety check on JiraAccountId before proceeding to Assign Jira Issue.\n\nconst items = $input.all();\n\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  // Safety net: if somehow a non-success item slips through, skip it gracefully\n  if (data.status === 'error') {\n    console.log(`Skipping item with error: ${data.error}`);\n    continue;\n  }\n\n  const jiraId = data.JiraAccountId;\n\n  if (!jiraId || String(jiraId).trim() === '') {\n    // Soft fail \u2014 log and skip, do not throw (would break the loop)\n    results.push({\n      json: {\n        ...data,\n        error: 'Jira ID account missing',\n        status: 'failed'\n      }\n    });\n    continue;\n  }\n\n  // All good \u2014 pass item through to Assign Jira Issue\n  results.push({\n    json: {\n      ...data,\n      status: 'success'\n    }\n  });\n}\n\nreturn results;"
      },
