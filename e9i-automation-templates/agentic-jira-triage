    {
      "parameters": {
        "jsCode": "// 1. Get the Jira Service Name we extracted earlier\nconst jiraServiceName = $node[\"Extract Service Name\"].json.serviceName.toLowerCase().trim();\n\n// 2. Access the original Jira Issue (from the batch) to keep the Ticket Key/ID\nconst jiraIssue = $node[\"Split In Batches\"].json;\n\n// 3. Access all rows from the Google Sheet node\nconst sheetRows = $items(\"Get row(s) in sheet\"); \n\nlet bestMatch = null;\n\n// 4. Loop through every row in the sheet to find a match\nfor (const row of sheetRows) {\n  // Replace 'Name' with the exact column header from your sheet\n  const sheetName = String(row.json.Name || \"\").toLowerCase().trim(); \n  \n  // CHECK: Does the Jira name contain the Sheet name?\n  if (sheetName && (jiraServiceName.includes(sheetName) || sheetName.includes(jiraServiceName))) {\n    bestMatch = row.json;\n    break; \n  }\n}\n\n// 5. Scenario: Vulnerability not identified\nif (!bestMatch) {\n  return [{ \n    json: { \n      ...jiraIssue, \n      error: \"Vulnerability not identified\", \n      status: \"error\",\n      originalName: jiraServiceName \n    } \n  }];\n}\n\n// 6. Scenario: Jira ID account missing\nif (!bestMatch.JiraAccountId || bestMatch.JiraAccountId.trim() === \"\") {\n  return [{ \n    json: { \n      ...jiraIssue, \n      ...bestMatch,\n      error: \"Jira ID account missing\", \n      status: \"error\" \n    } \n  }];\n}\n\n// 7. Success: Return the clean data from the sheet merged with Jira data\nreturn [{ \n  json: { \n    ...jiraIssue,      // Preserve Jira Ticket Key, Priority, etc.\n    ...bestMatch,      // Add Manager info and Jira ID\n    status: \"success\",\n    serviceName: bestMatch.Name // TRIMS/REPLACES the name with the clean Sheet version\n  } \n}];"
      },
