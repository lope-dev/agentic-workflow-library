    {
      "parameters": {
        "functionCode": "const items = [];\n\nfor (const item of $input.all()) {\n  const issue = item.json;\n\n  const priority = issue.fields?.priority?.name || 'Unspecified';\n  const discoveryDateStr = issue.fields?.created; // or your custom field\n  const discoveryDate = discoveryDateStr ? new Date(discoveryDateStr) : null;\n\n  let addDays = 0;\n\n  // \ud83d\udd0d Priority check happens here\n  if (priority === 'Critical') {\n    addDays = 20;\n  } else if (priority === 'High') {\n    addDays = 40;\n  } else {\n    addDays = 0; // Medium/Low \u2192 no remediation target, unless you want one\n  }\n\n  let remediationTargetDate = null;\n\n  if (discoveryDate && addDays > 0) {\n    const remediationDate = new Date(discoveryDate.getTime());\n    remediationDate.setDate(remediationDate.getDate() + addDays);\n    remediationTargetDate = remediationDate.toISOString().split('T')[0];\n  }\n\n  items.push({\n    json: {\n      ...issue,\n      serviceName: issue.serviceName,\n      ManagerName: issue.ManagerName,\n      ManagerEmail: issue.ManagerEmail,\n      JiraAccountId: issue.JiraAccountId,\n      priority,\n      discoveryDate: discoveryDateStr,\n      remediationTargetDate,   // will be null for non Critical/High\n    },\n  });\n}\n\nreturn items;\n\n\n\n// const discoveryDate = new Date($json.fields.created);\n// const priority = $json.fields.priority.name;\n// const daysToAdd = priority === 'Critical' ? 20 : 40;\n// discoveryDate.setDate(discoveryDate.getDate() + daysToAdd);\n// return [{ remediationDate: discoveryDate.toISOString().split('T')[0], key: $json.key, fields: $json.fields, Manager: $json.Manager }];"
