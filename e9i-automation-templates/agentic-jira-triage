      "parameters": {
        "functionCode": "// Extract service name from issue summary or description\nconst item = $input.item.json;\n\n// Get the service identifier from summary or description\nconst summary = item.fields?.summary || '';\nconst description = item.fields?.description || '';\n\n// Try to find service identifier in summary first, then description\nlet serviceIdentifier = summary;\nif (!serviceIdentifier) {\n  serviceIdentifier = description;\n}\n\n// Extract service name: if contains '/', take text after last '/'\n// Otherwise use the entire identifier\nlet serviceName = serviceIdentifier;\nif (serviceIdentifier.includes('/')) {\n  const parts = serviceIdentifier.split('/');\n  serviceName = parts[parts.length - 1];\n}\n\n// Return all input fields plus the new serviceName field\nreturn {\n \n  serviceName: serviceName.trim()\n};\n"
